@@ -0,0 +1,50 @@
+import { useEffect, useRef, useState } from "react";
+import { apiClient } from "../lib/api";
+
+export function useAgentHandoff(taskIds: string[], enabled = true) {
+	const identity = enabled ? taskIds.join(",") : "";
+	const currentIdentity = useRef(identity);
+	currentIdentity.current = identity;
+	const requestSequence = useRef(0);
+	const [copying, setCopying] = useState(false);
+	const [handoffText, setHandoffText] = useState("");
+	const [copyMessage, setCopyMessage] = useState("");
+	// 「完成后直接合并部署」只对当前这次选择生效，换任务或换选择即恢复不勾选。
+	const [deploy, setDeploy] = useState(false);
+
+	useEffect(() => {
+		requestSequence.current += 1;
+		setCopying(false);
+		setHandoffText("");
+		setCopyMessage("");
+		setDeploy(false);
+		return () => { requestSequence.current += 1; };
+	}, [identity]);
+
+	const copyForAgent = async () => {
+		if (!identity || copying) return;
+		const request = ++requestSequence.current;
+		const isCurrent = () => requestSequence.current === request && currentIdentity.current === identity;
+		setCopying(true);
+		setHandoffText("");
+		setCopyMessage("");
+		try {
+			const { text } = await apiClient.fetchAgentHandoff(taskIds.length === 1 ? taskIds[0]! : taskIds, deploy);
+			if (!isCurrent()) return;
+			try {
+				await navigator.clipboard.writeText(text);
+				if (isCurrent()) setCopyMessage(`已复制 ${taskIds.length} 项${deploy ? "（含完成后合并部署授权）" : ""}，请粘贴到 Agent 会话发送`);
+			} catch {
+				if (!isCurrent()) return;
+				setHandoffText(text);
+				setCopyMessage("自动复制失败，请选中下方指令手动复制");
+			}
+		} catch (err) {
+			if (isCurrent()) setCopyMessage(err instanceof Error ? err.message : "无法生成交接指令");
+		} finally {
+			if (isCurrent()) setCopying(false);
+		}
+	};
+
+	return { copying, handoffText, copyMessage, copyForAgent, deploy, setDeploy };
+}
