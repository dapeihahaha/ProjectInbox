+			});
+			const [output, errors, exitCode] = await Promise.all([
+				new Response(process.stdout).text(), new Response(process.stderr).text(), process.exited,
+			]);
+			const result = JSON.parse(exitCode === 0 ? output : errors);
+			if (exitCode !== 0) return Response.json({ error: result.error || "无法生成交接指令" }, { status: 400 });
+			return Response.json(result, { headers: { "Cache-Control": "no-store" } });
+		} catch {
+			return Response.json({ error: "无法生成交接指令，请检查 Project Inbox 本机安装" }, { status: 500 });
+		}
+	}
